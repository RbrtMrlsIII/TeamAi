rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /accounts/{uid} {
      allow read, write: if signedInAs(uid);

      // Commerce state is server-mutated, but a signed-in owner may read
      // their own intent, durable provider events, and entitlement projection.
      match /commerce/{correlationId} {
        allow read: if signedInAs(uid);
        allow write: if false;

        match /events/{providerEventId} {
          allow read: if signedInAs(uid);
          allow write: if false;
        }

        match /entitlements/{entitlementId} {
          allow read: if signedInAs(uid);
          allow write: if false;
        }
      }

      // GitHub App Connection map. Server-owned; browser never writes.
      match /githubInstallations/{installationId} {
        allow read: if signedInAs(uid);
        allow write: if false;
      }

      match /workplaces/{workplaceId} {
        allow read, write: if signedInAs(uid);

        match /projects/{projectId} {
          allow read, write: if signedInAs(uid);

          match /teams/{teamId} {
            allow read, write: if signedInAs(uid);

            match /seats/{seatId} {
              allow read, write: if signedInAs(uid);
            }
          }

          // Tasks and events are durable execution/evidence state.
          // Clients may observe their own state but must not self-attest
          // execution transitions or append authoritative evidence.
          match /tasks/{taskId} {
            allow read: if signedInAs(uid);
            allow write: if false;
          }

          match /events/{eventId} {
            allow read: if signedInAs(uid);
            allow write: if false;
          }
        }
      }
    }

    match /githubInstallationIndex/{installationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
