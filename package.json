{
  "name": "teamai",
  "version": "0.2.0",
  "private": true,
  "description": "TeamAi — Provider-Federated AI Team Workspace (Firebase + Supabase backend architecture)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && node dist/src/main.js",
    "start": "npm run build && node dist/src/main.js",
    "test:unit": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "project:package": "python3 build-system/scripts/project-package.py create-and-verify",
    "project:package:verify": "python3 build-system/scripts/project-package.py verify",
    "firebase:rules:gate": "bash build-system/scripts/firebase-rules-gate-004.sh",
    "backend:authority-audit": "python3 build-system/scripts/backend-authority-audit.py"
  },
  "dependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
